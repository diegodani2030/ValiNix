# ValiNix — reglas de Apache (InfinityFree)

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # El código, la configuración y los archivos SQL nunca se sirven directamente.
    RewriteRule ^(app|config|database|tests)(/|$) - [F,L]

    # Archivos ocultos (.git, .env, estado del deploy...), excepto .well-known.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Si el archivo o carpeta existe (css/, js/, assets/), se sirve tal cual.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás pasa por el front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>
